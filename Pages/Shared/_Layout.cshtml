<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="مكتب نوف الزهراني للمحاماة والتوثيق يقدم خدمات قانونية وتوثيقية باحترافية ووضوح في الرياض." />
    <meta name="robots" content="index, follow" />
    <title>@ViewData["Title"] - مكتب نوف الزهراني</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NoufLaw.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container-xl nav-shell">
                <a class="brand" asp-area="" asp-page="/Index" aria-label="مكتب نوف الزهراني">
                    <img src="~/images/nouf-logo-header.png" alt="مكتب نوف الزهراني للمحاماة والتوثيق" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse nav-menu">
                    <ul class="navbar-nav main-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Services">الخدمات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Blog">المدونة</a>
                        </li>
                    </ul>
                    <a class="nav-cta" href="https://wa.me/966556132288" target="_blank" rel="noreferrer">تواصل الآن</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-xl footer-grid">
            <div>
                <div class="footer-brand">مكتب نوف الزهراني</div>
                <p>خدمات محاماة وتوثيق مبنية على الوضوح، السرية، والدقة في الإجراءات.</p>
            </div>
            <div>
                <strong>روابط</strong>
                <a asp-page="/Index">الرئيسية</a>
                <a asp-page="/Services">الخدمات</a>
                <a asp-page="/Blog">المدونة</a>
            </div>
            <div>
                <strong>تواصل</strong>
                <a href="https://www.google.com/maps/place/%D9%85%D9%83%D8%AA%D8%A8+%D9%86%D9%88%D9%81+%D8%A7%D9%84%D8%B2%D9%87%D8%B1%D8%A7%D9%86%D9%8A+%D9%84%D9%84%D9%85%D8%AD%D8%A7%D9%85%D8%A7%D8%A9+%D9%88%D8%A7%D9%84%D8%AA%D9%88%D8%AB%D9%8A%D9%82%E2%80%AD/@@24.5946628,46.6927537,17z/data=!3m1!4b1!4m6!3m5!1s0x3e2f0f40b6ec3bd7:0x5b634521ddb64174!8m2!3d24.5946628!4d46.6953286!16s%2Fg%2F11x33ftngj?entry=ttu" target="_blank" rel="noreferrer">الدريهمية، الرياض</a>
                <a href="mailto:noufalzahrani9@icloud.com">noufalzahrani9@icloud.com</a>
                <a href="tel:+966556132288" dir="ltr">+966 55 613 2288</a>
            </div>
        </div>
        <div class="footer-bottom">© 2026 Nouf Alzahrani Law & Notary Office</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
