<section class="page-hero blog-hero blog-hero-dark">
    <div class="container-xl blog-hero-grid">
        <div>
            <span class="eyebrow">المدونة القانونية</span>
            <h1>مساحة معرفية لفهم الموضوعات القانونية العامة.</h1>
            <p>
                مقالات تثقيفية عن الأنظمة، العقود، التوثيق، الشركات، والإثبات. المحتوى عام ومخصص لرفع الوعي القانوني، ولا يمثل استشارة قانونية لحالة محددة.
            </p>
        </div>
        <div class="blog-hero-card">
            <span>موضوعات عامة</span>
            <h2>معرفة قانونية مبسطة بلغة واضحة.</h2>
            <p>نركز على شرح المفاهيم القانونية الأساسية وأثرها في التعاملات اليومية والتجارية.</p>
            <a href="#blogList">تصفح المقالات</a>
        </div>
    </div>
</section>

<section class="section blog-page-section blog-news-section">
    <div class="container-xl">
        <div class="blog-toolbar">
            <div>
                <span class="section-kicker">المقالات</span>
                <h2>موضوعات قانونية عامة.</h2>
            </div>
            <label class="blog-search">
                <span>بحث</span>
                <input id="blogSearch" type="search" placeholder="ابحث عن عقود، توثيق، شركات..." autocomplete="off" />
            </label>
        </div>

        <div class="blog-news-grid" id="blogList">
            @foreach (var post in posts)
            {
                <article class="blog-news-card" data-search="@post.Search">
                    <div class="blog-news-image" style="--blog-image: url('@post.Image')">
                        <span>@post.Date</span>
                    </div>
                    <div class="blog-news-body">
                        <span class="blog-category">@post.Category</span>
                        <h2>@post.Title</h2>
                        <p>@post.Excerpt</p>
                        <a href="#blogList">قراءة عامة</a>
                    </div>
                </article>
            }
        </div>

        <p class="blog-empty" id="blogEmpty">لا توجد مقالات مطابقة لبحثك.</p>
    </div>
</section>

<script>
    const blogSearch = document.getElementById("blogSearch");
    const blogCards = Array.from(document.querySelectorAll("#blogList .blog-news-card"));
    const blogEmpty = document.getElementById("blogEmpty");

    blogSearch?.addEventListener("input", () => {
        const term = blogSearch.value.trim().toLowerCase();
        let visibleCount = 0;

        blogCards.forEach((card) => {
            const text = `${card.textContent} ${card.dataset.search}`.toLowerCase();
            const isVisible = !term || text.includes(term);
            card.hidden = !isVisible;
            if (isVisible) visibleCount += 1;
        });

        blogEmpty.classList.toggle("show", visibleCount === 0);
    });
</script>
